{
  "name": "orderflow-operations",
  "version": "1.0.0",
  "private": true,
  "description": "Fullstack restaurant orders & courier delivery management platform (OrderFlow)",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=packages/backend\" \"npm run dev --workspace=packages/frontend\"",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspaces",
    "dev-db:setup": "node scripts/setup-db.mjs dev",
    "test-db:setup": "node scripts/setup-db.mjs test",
    "test": "npm run test --workspace=packages/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
